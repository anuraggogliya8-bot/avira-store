<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Avira - Luxury Essentials</title>
    <style>
        :root {
            --bg-color: #f7f5f0;
            --text-color: #2c2c2c;
            --accent-color: #8c7355;
            --card-bg: #ffffff;
            --border-color: #e3dec3;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
        }
        header {
            background-color: rgba(247, 245, 240, 0.95);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        .nav-left {
            display: flex;
            gap: 25px;
        }
        .nav-left a, .nav-right a {
            text-decoration: none;
            color: var(--text-color);
            font-weight: 500;
            font-size: 14px;
            cursor: pointer;
            transition: color 0.3s;
        }
        .nav-left a:hover, .nav-right a:hover {
            color: var(--accent-color);
        }
        .logo {
            font-size: 28px;
            font-weight: bold;
            letter-spacing: 3px;
            color: var(--text-color);
            font-family: serif;
        }
        .hero-banner {
            width: 100%;
            height: 450px;
            background: linear-gradient(rgba(0,0,0,0.25), rgba(0,0,0,0.25)), url('chopper.png') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            padding: 0 20px;
        }
        .hero-banner h1 {
            font-size: 48px;
            font-weight: normal;
            margin-bottom: 10px;
            font-family: serif;
            letter-spacing: 1px;
        }
        .container {
            max-width: 1200px;
            margin: 50px auto;
            padding: 0 20px;
        }
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
        }
        .product-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            text-align: center;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .product-card img {
            width: 100%;
            height: 220px;
            object-fit: contain;
            margin-bottom: 20px;
        }
        .product-card h3 {
            font-size: 18px;
            margin-bottom: 10px;
            font-weight: 600;
        }
        .product-card .price {
            font-size: 16px;
            color: var(--text-color);
            font-weight: bold;
            margin-bottom: 20px;
        }
        .details-btn {
            background-color: #2c2c2c;
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 14px;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.3s;
            letter-spacing: 1px;
        }
        .details-btn:hover {
            background-color: var(--accent-color);
        }
        footer {
            background-color: var(--bg-color);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 30px 50px;
            margin-top: 80px;
            color: #555;
            font-size: 14px;
        }
        .footer-links a {
            margin-right: 25px;
            text-decoration: none;
            color: #555;
            cursor: pointer;
        }
        .footer-links a:hover {
            color: var(--accent-color);
        }
        /* Modal Popup Styling */
        .modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background-color: var(--card-bg);
            padding: 30px;
            border-radius: 8px;
            width: 90%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        .modal-content h2 {
            margin-bottom: 10px;
            color: var(--accent-color);
        }
        .modal-content input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid var(--border-color);
            border-radius: 4px;
        }
        .close-btn {
            background: #ccc;
            color: #333;
            border: none;
            padding: 8px 15px;
            margin-top: 10px;
            border-radius: 4px;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <header>
        <div class="nav-left">
            <a onclick="scrollToSection('shop')">Shop</a>
            <a onclick="scrollToSection('story')">Our Story</a>
            <a onclick="scrollToSection('journal')">Journal</a>
        </div>
        <div class="logo">Avira</div>
        <div class="nav-right">
            <a onclick="openAccount()">Account</a>
        </div>
    </header>

    <!-- Hero Banner with exact text from image -->
    <section class="hero-banner">
        <h1>The Art of<br>Effortless Living</h1>
    </section>

    <div class="container" id="shop">
        <div class="products-grid">
            
            <!-- Product 1 -->
            <div class="product-card">
                <img src="mop.png" alt="Squeeze Mop">
                <h3>Avira Squeeze | Mop Head</h3>
                <div class="price">Rs. 1,499</div>
                <button class="details-btn" onclick="openCheckout('Avira Squeeze | Mop Head', 'Rs. 1,499')">View Details</button>
            </div>

            <!-- Product 2 -->
            <div class="product-card">
                <img src="chopper.png" alt="Smart Chopper">
                <h3>The Avira Chef | Precision Chopper</h3>
                <div class="price">Rs. 2,449</div>
                <button class="details-btn" onclick="openCheckout('The Avira Chef | Precision Chopper', 'Rs. 2,449')">View Details</button>
            </div>

            <!-- Product 3 -->
            <div class="product-card">
                <img src="chopper2.png" alt="Compact Chopper">
                <h3>Avira Pro | Push Chopper</h3>
                <div class="price">Rs. 1,899</div>
                <button class="details-btn" onclick="openCheckout('Avira Pro | Push Chopper', 'Rs. 1,899')">View Details</button>
            </div>

        </div>
    </div>

    <!-- Policies Section matching image footer layout -->
    <footer>
        <div class="footer-links">
            <a onclick="alert('1. Advance Payment: 100% advance required.\n2. Defective Replacement only.\n3. No Refunds.')">Contact</a>
            <a onclick="alert('FAQ: All luxury items are custom-curated for highest quality.')">FAQ</a>
            <a onclick="alert('Shipping: Fast and secure delivery across India.')">Shipping</a>
        </div>
        <div>
            <p>&copy; 2026 Avira. All rights reserved.</p>
        </div>
    </footer>

    <!-- Checkout Modal -->
    <div id="checkoutModal" class="modal">
        <div class="modal-content">
            <h2 id="modalProductTitle">Checkout</h2>
            <p id="modalProductPrice" style="margin-bottom: 15px; font-weight: bold; color: var(--accent-color);"></p>
            <input type="text" id="custName" placeholder="Enter Full Name" required>
            <input type="text" id="custPhone" placeholder="Enter Phone Number" required>
            <input type="text" id="custAddress" placeholder="Enter Delivery Address" required>
            <button class="details-btn" style="width: 100%; margin-top: 10px;" onclick="completeOrder()">Place Order via WhatsApp</button>
            <br>
            <button class="close-btn" onclick="closeCheckout()">Cancel</button>
        </div>
    </div>

    <script>
        function scrollToSection(sectionId) {
            document.getElementById(sectionId).scrollIntoView({ behavior: 'smooth' });
        }

        function openAccount() {
            alert("Avira Account Portal: Direct WhatsApp checkout is enabled for smooth purchases.");
        }

        function openCheckout(productName, price) {
            document.getElementById('modalProductTitle').innerText = productName;
            document.getElementById('modalProductPrice').innerText = price;
            document.getElementById('checkoutModal').style.display = 'flex';
        }

        function closeCheckout() {
            document.getElementById('checkoutModal').style.display = 'none';
        }

        function completeOrder() {
            const name = document.getElementById('custName').value;
            const phone = document.getElementById('custPhone').value;
            const address = document.getElementById('custAddress').value;
            const productName = document.getElementById('modalProductTitle').innerText;
            const productPrice = document.getElementById('modalProductPrice').innerText;

            if(name && phone && address) {
                const message = `New Order!%0AProduct: ${productName}%0APrice: ${productPrice}%0AName: ${name}%0APhone: ${phone}%0AAddress: ${address}`;
                const whatsappUrl = `https://wa.me/917082576926?text=${message}`;
                window.open(whatsappUrl, '_blank');
                closeCheckout();
            } else {
                alert("Kripya saari details (Name, Phone, Address) thik se bharein!");
            }
        }
    </script>
</body>
</html>